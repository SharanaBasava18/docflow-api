ENV="dev"
APP_UPLOAD_DIR="/uploads"
APP_MAX_CHUNK_SIZE="10485760"

MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_PUBLIC_BUCKET="public"
MINIO_PRIVATE_BUCKET="private"
MINIO_ENDPOINT="minio:9000"
MINIO_URL="http://localhost:9001"

DATABASE_URL="postgresql+psycopg://docflow:docflow@db-postgres:5432/docflow"
TEST_DATABASE_URL="postgresql+psycopg://docflow:docflow@db-postgres:5432/docflow_test"
POSTGRES_USER="docflow"
POSTGRES_PASSWORD="docflow"
POSTGRES_DB="docflow"

JWT_SECRET_KEY="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60"

RABBITMQ_DEFAULT_USER="docflow"
RABBITMQ_DEFAULT_PASS="docflow"
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT="5672"
